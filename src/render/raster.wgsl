struct VertexOut {@builtin(position) position:vec4f,@location(0) world:vec3f,@location(1) normal:vec3f,@location(2) uv:vec2f,@location(3) @interpolate(flat) mat:u32,@location(4) @interpolate(flat) object:u32,@location(5) bary:vec3f,@location(6) @interpolate(flat) tri:u32};
@vertex fn vertexMain(@builtin(vertex_index) i:u32)->VertexOut {let t=triangles[i/3u];let j=i%3u;let ps=array<vec3f,3>(t.a.xyz,t.b.xyz,t.c.xyz);let ns=array<vec3f,3>(t.n0.xyz,t.n1.xyz,t.n2.xyz);let uvs=array<vec2f,3>(t.uv01.xy,t.uv01.zw,t.uv2.xy);let bary=array<vec3f,3>(vec3f(1.,0.,0.),vec3f(0.,1.,0.),vec3f(0.,0.,1.));var position=cam.vp*vec4f(ps[j],1.);if((u32(t.uv2.z)&1u)!=0u){position=vec4f(2.,2.,2.,1.);}return VertexOut(position,ps[j],ns[j],uvs[j],u32(t.a.w),u32(t.b.w),bary[j],i/3u);}
@fragment fn fragmentMain(v:VertexOut,@builtin(front_facing) front:bool)->@location(0) vec4f {let gridWidths=max(fwidth(v.world.xz),vec2f(.001));let m=surfaceMaterial(v.mat,v.world,v.uv);setupFiber(triangles[v.tri],normalize(v.normal));let n=normalize(v.normal)*select(-1.,1.,front);let wo=normalize(cam.eye.xyz-v.world);let color=m.base.rgb;var light=color*environment(n)*(.32+.68*max(n.y,0.))*(1.-m.params.x);let directions=array<vec3f,3>(normalize(vec3f(-3.,6.,4.)),normalize(vec3f(3.,4.,-4.)),normalize(vec3f(-4.,2.,-3.)));let strengths=array<f32,3>(3.2,2.,.7);for(var i=0u;i<3u;i++){let wi=directions[i];light+=evaluateBSDF(m,color,n,wo,wi).f*max(dot(n,wi),0.)*strengths[i];}let reflected=reflect(-wo,n);let f0=mix(vec3f(.04),color,m.params.x);light+=environment(reflected)*fresnelSchlick(max(dot(n,wo),0.),f0)*(1.-m.base.w*.6);light+=color*m.params.w;if(m.params.y>.0){light=mix(light,environment(reflected)*.9+color*.1,m.params.y);}if(cam.misc.x>.5&&abs(v.world.y+.09)<.003){let q=v.world.xz;let widths=gridWidths;let grid=1.-min(1.,min(abs(fract(q-.5)-.5).x/widths.x,abs(fract(q-.5)-.5).y/widths.y));light=mix(light,light*.6,grid*.35);}
 var outColor=displayColor(light);if(cam.info.w==1.){outColor=displayColor(color);}if(cam.info.w==2.){outColor=n*.5+.5;}if(cam.info.w==3.){outColor=vec3f(exp(-length(cam.eye.xyz-v.world)*.08));}if(cam.info.w==4.){outColor=.5+.5*cos(vec3f(0.,2.,4.)+f32(v.object)*2.4);}
 let d=fwidth(v.bary);let edge=1.-min(min(smoothstep(vec3f(0.),d*1.1,v.bary).x,smoothstep(vec3f(0.),d*1.1,v.bary).y),smoothstep(vec3f(0.),d*1.1,v.bary).z);if(cam.misc.y>.5){outColor=mix(outColor,vec3f(.12,.15,.18),edge*.8);}if(f32(v.object)==cam.info.z){outColor=mix(outColor,vec3f(.96,.55,.27),edge*.65);}return vec4f(outColor,1.);}
