 test('Packed texture/volume metadata keeps graph offsets and float-aligned voxel tables',()=>{const d=emptyDocument();d.textures=[createPaintTexture({size:2,udim:true})];d.volumes=[{name:'Fog',min:[-1,0,-1],max:[1,2,1],density:2,color:[.9,.8,.7],grid:proceduralDensity({dimensions:[8,8,8]})}];const a=compileSceneAssets(d);assert.equal(a.textureCount,1);assert.equal(a.volumeCount,1);assert.equal(a.data.length%16,0);assert.equal(a.data[a.textureOffset*16],1);const off=a.volumeOffset*16;assert.deepEqual(Array.from(a.data.slice(off,off+4)),[8,8,8,2]);assert.ok(a.data[off+7]>0);assert.equal(a.data[off+4]%16,0);assert.equal(a.sources.length,1);assert.equal(a.volumeBounds.min[1],0);});
